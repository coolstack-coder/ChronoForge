// Session tokens live for 2ms. The work in between usually takes less.
// On a slow machine (or a busy CI box) it doesn't. Classic flaky test.

let issued = now();
let ttl = 2;

fn crunch(n) {
    let acc = 0;
    for i in 0..n {
        acc = (acc * 31 + i) % 1000003;
    }
    return acc;
}

let checksum = crunch(3000);
let elapsed = now() - issued;
print("checksum", checksum, "elapsed", elapsed, "ms");
assert(elapsed < ttl, "token expired after " + str(elapsed) + "ms");
